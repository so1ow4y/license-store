# ============================================================================
#  Скопируй в .env перед первым запуском:  cp .env.example .env
#  .env в git не коммитится никогда. Значения пишутся БЕЗ кавычек:
#  `docker --env-file`, в отличие от dotenv, кавычки не снимает.
# ============================================================================

# Порты на хосте сдвинуты от стандартных (+10), чтобы не конфликтовать с
# другими локальными стеками. Внутри docker-сети порты стандартные.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=lp
POSTGRES_PASSWORD=lp_dev_password
POSTGRES_DB=license_platform
POSTGRES_PORT=5442
DATABASE_URL=postgresql://lp:lp_dev_password@localhost:5442/license_platform?schema=public

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=lp_dev_password
REDIS_PORT=6389
REDIS_URL=redis://:lp_dev_password@localhost:6389/0

# --- S3 (локально RustFS; консоль http://localhost:9001) ---------------------
# Этими же ключами запускается контейнер s3. Бакеты API создаёт сам.
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=lpadmin
S3_SECRET_KEY=lp_dev_password
S3_BUCKET_RELEASES=releases
# Бакет payload'а (ТЗ §7): отдельный и приватный, presigned-ссылки на него
# запрещены кодом. Совпадение с releases останавливает старт.
S3_BUCKET_PAYLOADS=payloads
S3_FORCE_PATH_STYLE=true
S3_CONNECT_TIMEOUT_MS=3000
S3_REQUEST_TIMEOUT_MS=15000
# Дедлайн на чтение объекта целиком (таймаут запроса не покрывает медленный стрим).
S3_READ_DEADLINE_MS=30000

# --- Почта (локально — ловушка Mailpit, UI http://localhost:8025) -----------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=License Platform <noreply@license-platform.local>

# Свой почтовый сервер в бою включается одним признаком: SMTP_HOST=postfix
# в .env.production (имя без точки — по нему mail.service.ts понимает, что
# релей свой). Тогда deploy.sh поднимает профиль mail. Нужны:
# MAIL_DOMAIN=example.com
# MAIL_FORWARD_TO=человек@gmail.com     # куда пересылать support@, abuse@ и т.п.
# MAIL_MX_HOSTNAME=mail.example.com
# MAIL_DKIM_SELECTOR=mail
# DKIM_* НЕ заполнять: подписывает opendkim, двойная подпись ломает проверку.

# ============================================================================
#  КРИПТОГРАФИЯ. Сгенерировать каждое значение:  openssl rand -hex 32
#  Все три обязаны различаться, на проде — свои.
# ============================================================================

# Подпись access-токенов. Смена разлогинивает всех — и только.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Токен краевых агентов (nginx и фаервол забирают по нему списки блокировок
# и доверенных адресов). Пусто — блоки уровней «nginx» и «фаервол» действуют
# только в самом приложении. Агент фаервола: docker compose --profile firewall up -d
EDGE_AGENT_TOKEN=

# Соль хеша HWID. НЕ МЕНЯТЬ после запуска: все привязки устройств умрут.
HWID_PEPPER=CHANGE_ME_openssl_rand_hex_32

# Шифрование полей БД (2FA, HWID, секреты API-ключей и способов оплаты).
# Потеря = эти данные не восстановить. Хранить отдельно от бэкапов базы.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
ENCRYPTION_KEY_VERSION=1
# Ротация без простоя: старый ключ сюда ("1:hex,2:hex"), новый — в
# ENCRYPTION_KEY, версию +1.
# ENCRYPTION_KEYS_RETIRED=1:0123...

# Argon2id — главный потребитель CPU на логине (64 МБ, t=3 ≈ 70 мс на хеш).
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- Digiseller -------------------------------------------------------------
DIGISELLER_SELLER_ID=
DIGISELLER_API_KEY=
DIGISELLER_API_BASE=https://api.digiseller.com
DIGISELLER_TOKEN_CACHE_TTL=6600

# --- OAuth ------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback

# Токен бота от @BotFather: им же проверяется подпись Telegram Login Widget.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Telegram-бот -----------------------------------------------------------
# При true обязательны TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_USERNAME и два РАЗНЫХ
# секрета вебхука (≥32 символов), иначе API не стартует. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_BOT_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_HEADER_SECRET=
# Группа владельца для поддержки и алертов (id отрицательный, -100...).
TELEGRAM_ADMIN_CHAT_ID=

# --- Приложение -------------------------------------------------------------
NODE_ENV=development
APP_PORT=3000
NGINX_PORT=8080
LOG_LEVEL=info
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- Payload (ТЗ §7) --------------------------------------------------------
# Здесь только то, что определяет память процесса; пороги выдач — в settings.
# Потолок открытого текста зашит и в клиенте (Config.h) — выше 8 МиБ нельзя.
PAYLOAD_MAX_BYTES=8388608
PAYLOAD_CACHE_MAX_BYTES=67108864
PAYLOAD_CACHE_TTL_MS=60000
# Байтовый бюджет одновременных выдач; исчерпание → 503 + Retry-After.
PAYLOAD_INFLIGHT_MAX_BYTES=134217728

# --- Ретенция журналов (npm run db:partitions) ------------------------------
AUDIT_LOG_RETENTION_DAYS=90
LOGIN_HISTORY_RETENTION_DAYS=90
