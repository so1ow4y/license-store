# Всё, что не должно попасть в контекст сборки.
# Помимо размера образа это вопрос безопасности: .env с боевыми ключами,
# случайно уехавший в слой образа, оттуда уже не удаляется.

node_modules
dist
.env
.env.*
*.log

# Тесты и инструменты разработки в рантайме не нужны.
test
**/*.spec.ts
**/*.e2e-spec.ts
vitest.config.ts
.eslintrc*
.prettierrc*

.git
.gitignore
.vscode
.idea
