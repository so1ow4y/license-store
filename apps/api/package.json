{
  "name": "@license-platform/api",
  "version": "0.1.0",
  "private": true,
  "description": "License Platform API — NestJS modular monolith",
  "engines": {
    "node": ">=22"
  },
  "//allowScripts": "npm 11+ блокирует postinstall по умолчанию. Этим пакетам скрипты нужны: Prisma качает движки запросов, esbuild и @node-rs/argon2 — свои нативные бинари. Список явный — новый пакет со скриптом молча не выполнится.",
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "@node-rs/argon2": true,
    "@swc/core": true,
    "@scarf/scarf": false
  },
  "scripts": {
    "build": "nest build -b swc",
    "start": "nest start -b swc",
    "dev": "nest start -b swc --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:partitions": "tsx prisma/maintenance.ts",
    "tg:webhook": "tsx scripts/telegram-webhook.ts",
    "tg:commands": "tsx scripts/telegram-commands.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/static": "^9.3.0",
    "@nestjs/common": "^11.0.6",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.0.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.3.0",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.6",
    "@swc/cli": "^0.8.1",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.4"
  }
}
