{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "moduleResolution": "node",

    // NestJS построен на декораторах и рефлексии типов — без этих двух
    // флагов DI не сможет определить, что инжектить в конструктор.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "declaration": false,
    "removeComments": false,
    "sourceMap": true,
    "incremental": true,
    "outDir": "./dist",
    "baseUrl": "./",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Строгий режим целиком. Платформа лицензирования — не то место, где
    // стоит экономить на проверках: тихий undefined в проверке срока
    // действия лицензии стоит дороже, чем пара часов на типизацию.
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // Ловит забытый await у промисов — в коде, где каждая вторая операция
    // это запрос к БД, это самый частый источник гонок.
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,

    "paths": {
      "@/*": ["src/*"],
      "@common/*": ["src/common/*"],
      "@modules/*": ["src/modules/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "prisma/**/*", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
