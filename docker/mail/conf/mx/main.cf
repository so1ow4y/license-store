# ============================================================================
#  РОЛЬ «mx» — публичный приёмник почты для pxcheats.com.
#
#  Это ЕДИНСТВЕННЫЙ контейнер проекта, у которого опубликованы порты наружу
#  (25 всегда, 587 — когда включат submission). Поэтому здесь действует одно
#  жёсткое правило, ради которого роли и разделены:
#
#      В ЭТОМ ФАЙЛЕ НЕТ НИ ОДНОЙ ДИРЕКТИВЫ, РАЗРЕШАЮЩЕЙ РЕЛЕЙ ПО IP-АДРЕСУ.
#
#  Зачем это нужно — конкретная ловушка docker. Docker публикует порты в обход
#  ufw, и при части конфигураций (userland-proxy, IPv6 без ip6tables) входящее
#  соединение приходит в контейнер С АДРЕСА ШЛЮЗА docker-сети, то есть изнутри
#  172.x. Если бы здесь стояло `permit_mynetworks` с подсетью compose, весь
#  интернет оказался бы «своей сетью» — открытый релей мирового масштаба,
#  работающий ровно с той минуты, как опубликован порт.
#
#  `permit_mynetworks` живёт только в роли «out», у которой портов нет.
#
#  Что делает этот контейнер с почтой: НИЧЕГО, кроме пересылки. Ни ящиков, ни
#  футеров, ни фильтров содержимого, ни переписывания заголовков. Причина
#  техническая: при пересылке в Gmail SPF заведомо не сойдётся (письмо идёт с
#  нашего IP от чужого отправителя), и единственное, что спасает пересланное
#  письмо от спам-папки, — УЦЕЛЕВШАЯ ИСХОДНАЯ ПОДПИСЬ DKIM отправителя.
#  Любая правка тела или заголовков её ломает.
#
#  Значения, помеченные [entrypoint], перекрываются при старте из переменных
#  окружения — см. docker/mail/entrypoint.sh.
# ============================================================================

compatibility_level = 3.6

# --- Кто мы -----------------------------------------------------------------

# [entrypoint: MAIL_MX_HOSTNAME] Имя в баннере SMTP и в HELO при пересылке.
# Здесь оно СОВПАДАЕТ с записями MX и A (mail.pxcheats.com → 77.221.154.85), и
# так правильно: приёмник обязан представляться тем именем, по которому его
# нашли. У роли «out» имя другое (pxcheats.com) и меняться не должно — там
# работает проверенная живой доставкой настройка.
myhostname = mail.pxcheats.com

# [entrypoint: MAIL_DOMAIN]
mydomain = pxcheats.com
myorigin = $mydomain

# --- Что принимаем ----------------------------------------------------------

# ПУСТО. Локальной доставки нет вовсе: ни одного почтового ящика в системе,
# значит нечего переполнять, нечего бэкапить, некуда доставить по ошибке.
mydestination =
alias_maps =
alias_database =

# ПУСТО БЫТЬ НЕ ДОЛЖНО, И ЭТО САМАЯ КОНТРИНТУИТИВНАЯ СТРОКА ФАЙЛА.
#
# ЧТО К ПРОБЛЕМЕ ВЕЛО: раньше здесь стояло `local_recipient_maps =`, и
# читается это как «локальных получателей нет ни одного». У postfix пустое
# значение означает РОВНО ОБРАТНОЕ: «проверку не делать, принимать всех».
# Так и написано в документации: с пустой картой SMTP-сервер принимает любого
# получателя ЛОКАЛЬНОГО класса адресов.
#
# А локальный класс — это не только $mydestination (он пуст), но и АДРЕСА
# ИНТЕРФЕЙСОВ, записанные литералом в квадратных скобках: при
# inet_interfaces = all туда входят 127.0.0.1 и адрес контейнера в сети
# docker. Итог: `RCPT TO:<foo@[127.0.0.1]>` получал 250, письмо ложилось в
# очередь, уходило в local(8), где нет ни ящиков, ни алиасов, — и возвращалось
# ОТЛУПОМ с телом письма на адрес отправителя, который злоумышленник
# подставил. То есть ровно «принять и отбить», запрещённое ниже по файлу.
#
# [entrypoint] Карта СУЩЕСТВУЕТ и ПУСТА по содержимому: любой получатель
# локального класса не находится в ней и отвергается кодом 550 на RCPT TO
# (smtpd_reject_unlisted_recipient ниже). Пустой файл вместо пустого значения
# — вся разница между «принимаем всех» и «не принимаем никого».
local_recipient_maps = hash:/etc/postfix/local_recipients

# Мы никому не резервный MX и ничего не передаём дальше.
relay_domains =

# Домен принимается как ВИРТУАЛЬНЫЙ АЛИАС-ДОМЕН: каждый адрес обязан быть
# перечислен в карте, всё остальное отвергается на этапе RCPT TO.
# [entrypoint: MAIL_DOMAIN]
virtual_alias_domains = pxcheats.com
virtual_alias_maps = hash:/etc/postfix/virtual

# Отказ 550 в момент RCPT TO, НИКОГДА «принять и отбить».
#
# Принять письмо, а потом сгенерировать отлуп, — это backscatter: адрес
# отправителя у ботов подделан, отлуп уходит невиновному, и мы оказываемся в
# чёрных списках как источник спама. Отказ на этапе RCPT перекладывает
# ответственность на отправителя и не стоит нам ни байта очереди.
smtpd_reject_unlisted_recipient = yes
unknown_address_reject_code = 550
# `yes` превратил бы все 5xx в 4xx — отладочный режим, в бою он означает,
# что мусор возвращается снова и снова вместо того, чтобы уйти навсегда.
soft_bounce = no

# --- Релей: не разрешён никому и ни при каких условиях ----------------------

# Только петля. Никаких подсетей docker — см. заголовок файла.
# Без [::1]/128: ниже inet_protocols = ipv4, и адрес выключенного семейства
# в списке — строка, которая ничего не делает, но выглядит осмысленной.
mynetworks = 127.0.0.0/8
# Страховка: если mynetworks однажды сотрут, postfix НЕ станет считать своей
# всю подсеть интерфейса (стиль по умолчанию — «subnet»).
mynetworks_style = host

# На порту 25 SASL выключен (см. master.cf), поэтому permit_sasl_authenticated
# там никогда не срабатывает и от строки остаётся только reject. На 587 он
# срабатывает — и это единственный способ отправить через нас что-либо наружу.
smtpd_relay_restrictions = permit_sasl_authenticated, reject_unauth_destination

# reject_non_fqdn_recipient СТОИТ ПЕРВЫМ, ДО permit_*, и это не косметика.
#
# ЧТО К ПРОБЛЕМЕ ВЕЛО. Локальный класс адресов у postfix — это не только
# $mydestination (он пуст), но и АДРЕСА ИНТЕРФЕЙСОВ, записанные литералом в
# квадратных скобках. При inet_interfaces = all туда попадают 127.0.0.1 и
# адрес контейнера в сети docker. Поэтому `RCPT TO:<foo@[127.0.0.1]>`
# проходил reject_unauth_destination как «наш» адрес, а следующий барьер,
# reject_unlisted_recipient, для локального класса смотрит в
# local_recipient_maps — а она пуста, и пустое значение у postfix означает
# не «никого нет», а «не проверять, принимать всех».
#
# Итог был ровно тот сценарий, который запрещён абзацем «Отказ 550 в момент
# RCPT TO, НИКОГДА принять и отбить» выше по файлу:
# 250 на RCPT, письмо в очереди, доставка в local(8), где нет ни ящиков, ни
# алиасов, — и ОТЛУП с телом письма на адрес, который отправитель подставил.
# То есть backscatter на существующем механизме, при исправной защите от
# релея (наружу такое письмо не уходит — этому мешает allow_untrusted_routing).
#
# reject_non_fqdn_recipient отвергает адрес-литерал на RCPT TO кодом 5xx:
# у него нет доменного имени. Легитимный MX литералами не пользуется никогда.
smtpd_recipient_restrictions =
    reject_non_fqdn_recipient,
    permit_sasl_authenticated,
    reject_unauth_destination,
    reject_unlisted_recipient

# --- Закрытие обходных путей адресации --------------------------------------
#
# Здесь это не формальность: именно на публичном порту эти трюки и пробуют.

# РАСШИРЕНИЕ DSN (RFC 3461) НЕ ОБЪЯВЛЯЕТСЯ И ЕГО ПАРАМЕТРЫ НЕ ПРИНИМАЮТСЯ.
#
# ЧТО К ПРОБЛЕМЕ ВЕЛО: у smtpd_discard_ehlo_keywords значение по умолчанию
# пусто, то есть smtpd анонсировал DSN и принимал его параметры. Дальше
# работал канал рассылки, который не является релеем и не ловится ни одной
# проверкой релея, потому что получатель — НАШ существующий адрес:
#
#     MAIL FROM:<жертва@example.com> RET=FULL
#     RCPT TO:<support@pxcheats.com> NOTIFY=SUCCESS
#     DATA  <текст злоумышленника>
#
# Письмо принимается штатно и пересылается на Gmail. Gmail не подтверждает
# доставку по DSN, поэтому postfix САМ сочиняет уведомление «relayed» и
# отправляет его на адрес из MAIL FROM — то есть на любой адрес, который
# назвал отправитель: с нашего IP, от MAILER-DAEMON@pxcheats.com, с валидными
# PTR и SPF, а при RET=FULL — с вложенным текстом отправителя (до
# bounce_size_limit, 50 КБ по умолчанию; для фишинга этого хватает с запасом).
#
# Это ровно то, за что попадают в Backscatterer.org и UCEPROTECT L1, а оттуда
# выходят месяцами — вместе с отправкой платформы, у которой тот же IP.
#
# silent-discard убирает предупреждение в журнале на каждое соединение;
# оно ничего не сообщает, кроме того, что настройка работает.
#
# Действует и на 587 (значение берётся из main.cf, в master.cf оно не
# переопределено) — и это правильно: почтовому клиенту владельца уведомления
# о доставке не нужны, а форма запроса у них та же самая.
smtpd_discard_ehlo_keywords = silent-discard, dsn

# `user@remote@pxcheats.com` и `@remote:user@pxcheats.com`.
allow_untrusted_routing = no
# `user%gmail.com@pxcheats.com` — postfix иначе перепишет в user@gmail.com
# ПОСЛЕ проверок.
allow_percent_hack = no
# UUCP-нотация `gmail.com!user@pxcheats.com`.
swap_bangpath = no

# XCLIENT/XFORWARD позволяют клиенту объявить себя другим IP-адресом.
# Заполнение любого из этих полей обнуляет ВСЕ защиты выше.
smtpd_authorized_xclient_hosts =
smtpd_authorized_xforward_hosts =

# --- Гигиена отправителя ----------------------------------------------------

smtpd_helo_required = yes
smtpd_helo_restrictions =
    reject_invalid_helo_hostname,
    reject_non_fqdn_helo_hostname

smtpd_sender_restrictions =
    reject_non_fqdn_sender,
    reject_unknown_sender_domain

# Клиент, который шлёт команды пачкой, не дождавшись разрешения (PIPELINING),
# почти всегда бот: настоящий MTA сначала смотрит на EHLO-ответ.
smtpd_data_restrictions = reject_unauth_pipelining

# --- Дешёвые ограничители перебора ------------------------------------------

# VRFY — штатный инструмент перебора адресов.
disable_vrfy_command = yes
# После 5 грубых ошибок соединение рвётся, после 3 бессмысленных команд — тоже.
smtpd_hard_error_limit = 5
smtpd_junk_command_limit = 3
# Пауза перед каждым отказом. Пять секунд человек не заметит, а перебор
# 20 адресов растянется на минуту с лишним.
smtpd_error_sleep_time = 5s
smtpd_recipient_limit = 20
smtpd_timeout = 30s
message_size_limit = 10485760
mailbox_size_limit = 0

# Пределы на клиента (считает служба anvil). Легитимный MX укладывается
# в них с огромным запасом: у нас четыре адреса и десяток писем в день.
smtpd_client_connection_count_limit = 10
smtpd_client_connection_rate_limit = 30
smtpd_client_message_rate_limit = 30
smtpd_client_recipient_rate_limit = 60
# Попыток входа с одного адреса в минуту. Заменяет возню с fail2ban, который
# в json-file журнал docker смотреть не умеет без отдельного файла.
smtpd_client_auth_rate_limit = 10

# --- postscreen -------------------------------------------------------------
#
# Работает ПЕРЕД smtpd, одним процессом, без форка на каждое соединение — на
# одном ядре это критично.
#
# Главный тест — «заговорил раньше баннера». Настоящий MTA обязан дождаться
# приветствия; спам-боты почти поголовно шлют EHLO сразу, чтобы сэкономить
# время. Этот тест отсеивает большинство мусора БЕЗ ЕДИНОГО ОБРАЩЕНИЯ НАРУЖУ.
postscreen_greet_action = enforce
postscreen_pipelining_enable = yes
postscreen_pipelining_action = enforce
postscreen_non_smtp_command_enable = yes
postscreen_non_smtp_command_action = enforce
postscreen_bare_newline_enable = yes
postscreen_bare_newline_action = enforce
postscreen_access_list = permit_mynetworks
# Сколько держать «разрешение» для проверенного клиента, чтобы не гонять его
# через тесты на каждое письмо.
postscreen_cache_map = btree:$data_directory/postscreen_cache
postscreen_greet_ttl = 1d

# DNSBL (Spamhaus и подобные) СОЗНАТЕЛЬНО ВЫКЛЮЧЕН на старте. Это внешняя
# зависимость, требующая собственного резолвера: Spamhaus блокирует запросы
# от публичных DNS (8.8.8.8 и подобных), и настройка ТИХО перестаёт работать,
# начиная отвечать «не в списке» на любой запрос. Плюс лишний DNS-обмен на
# каждое соединение. Включать, только если объём мусора реально станет мешать,
# и только вместе со своим unbound.
#
# postscreen_dnsbl_sites = zen.spamhaus.org*2 bl.spamcop.net*1
# postscreen_dnsbl_threshold = 2
# postscreen_dnsbl_action = enforce

# Greylisting не ставим: он задерживает ВСЮ легитимную почту ради проблемы,
# которой у нас на этих объёмах нет.
#
# rspamd/spamassassin не ставим: конечный получатель — Gmail, его фильтр
# лучше всего, что можно поднять на одном ядре, а rspamd съел бы 100-200 МБ,
# которых на этой машине нет. Наша задача — не пропускать мусор в очередь
# (это делает postscreen за копейки), а не сортировать его.

# --- TLS --------------------------------------------------------------------
#
# [entrypoint] Пути к сертификату проставляются при старте, если каталог с
# сертификатами nginx смонтирован и файлы на месте. Без них уровень падает
# до `none` и STARTTLS просто не предлагается — почта продолжает приходить
# открытым текстом, как и до появления TLS в SMTP вовсе.
#
# `may`, а не `encrypt`: приёмник, требующий TLS, теряет почту от отправителей,
# которые его не умеют. Для порта 25 это всегда оппортунистический режим.
smtpd_tls_security_level = may
smtpd_tls_loglevel = 1
# AUTH не предлагается, пока не поднят TLS. Пароль никогда не идёт открытым
# текстом. Действует и на 587 — там уровень поднят до `encrypt` в master.cf.
smtpd_tls_auth_only = yes

# Исходящий TLS: этим же контейнером уходит ПЕРЕСЫЛАЕМАЯ почта на Gmail.
smtp_tls_security_level = may
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1

# --- SASL -------------------------------------------------------------------
#
# На порту 25 аутентификации НЕТ ВООБЩЕ: нечего подбирать и нечем открыть
# релей украденным паролем. Включается только в службе submission (master.cf).
smtpd_sasl_auth_enable = no
smtpd_sasl_type = cyrus
smtpd_sasl_path = smtpd
# [entrypoint: MAIL_DOMAIN] Область имён SASL.
#
# ЗАЧЕМ ОНА ЗАДАНА, А НЕ ПУСТА. Пустая область — классическая ловушка Cyrus
# SASL: при проверке пароля он подставляет туда имя машины (gethostname), то
# есть случайный идентификатор контейнера, и учётка, заведённая при сборке,
# перестаёт находиться после первого же пересоздания. С явной областью логин
# всегда «support@pxcheats.com» — и именно его ждёт карта sender_login, и
# именно его удобно вводить в стороннем клиенте.
smtpd_sasl_local_domain = pxcheats.com
smtpd_sasl_security_options = noanonymous
smtpd_sasl_tls_security_options = noanonymous

# Кто под какой учёткой имеет право писать от какого адреса. Без этой карты
# владелец учётки support@ мог бы отправлять от noreply@ — и, что важнее,
# любой, кто украдёт пароль, отправлял бы от чего угодно с нашей подписью.
# Применяется только на 587 (см. reject_sender_login_mismatch в master.cf).
smtpd_sender_login_maps = hash:/etc/postfix/sender_login

# --- Подпись DKIM -----------------------------------------------------------
#
# НА ПОРТУ 25 MILTER'А НЕТ, И ЭТО НАМЕРЕННО.
#
# Входящая почта не должна ни подписываться (пересылаемый спам не поедет в
# Gmail с нашей репутацией), ни даже помечаться: opendkim в режиме проверки
# ДОПИСЫВАЕТ заголовок Authentication-Results, а мы обещали не трогать
# сообщения — от этого зависит выживание исходной подписи отправителя.
# Проверять чужие подписи нам и не нужно: этим займётся Gmail, куда письмо
# и уедет.
#
# Milter подключается только к службе submission (master.cf), где письмо
# действительно наше и его надо подписать.
smtpd_milters =
non_smtpd_milters =
milter_default_action = accept

# --- Очередь и пределы ------------------------------------------------------

maximal_queue_lifetime = 3d
bounce_queue_lifetime = 1d
# 8 вместо сотни: приёмнику на одном ядре больше нечем занять процессор.
#
# ЧТО К ПРОБЛЕМЕ ВЕЛО: было 20 при mem_limit 96m у контейнера. Под потоком
# живут ОДНОВРЕМЕННО до 20 smtpd + до 20 cleanup + до 20 smtp + tlsproxy +
# qmgr + anvil + master, то есть шестьдесят с лишним процессов на 96 МБ.
# Первым под OOM уходит не тот, кто виноват, а тот, кто крупнее.
# 8 — это ~25 процессов в пике, и это всё ещё вчетверо больше, чем нужно
# домену с десятком писем в день.
default_process_limit = 8

# ЧТО К ПРОБЛЕМЕ ВЕЛО, ЧАСТЬ ВТОРАЯ. Строка выше в одиночку выключила приём
# почты целиком:
#
#   postfix/postscreen: fatal: invalid postscreen_pre_queue_limit value 8 < 10
#
# postscreen_pre_queue_limit по умолчанию равен $default_process_limit, а
# postfix отказывается запускаться при значении меньше 10. Понизив общий
# предел до 8, мы задали postscreen недопустимое значение, о котором нигде
# не просили. Дальше master поднимал postscreen, тот падал, master ждал и
# поднимал снова — и так бесконечно. Снаружи это выглядит хуже всего: порт
# 25 принимает соединение (его держит docker-proxy), но баннера не приходит
# никогда, потому что за портом никого нет.
#
# ПОЧЕМУ ЗДЕСЬ 20, А НЕ 10 И НЕ $default_process_limit. Этот предел считает
# СОЕДИНЕНИЯ, а не процессы: их все обслуживает один процесс postscreen.
# Двадцать соединений стоят килобайты, тогда как двадцать smtpd стоили бы
# десятки мегабайт — то есть ровно то, ради чего предел выше понижен. Связывать
# эти два числа было ошибкой: у них разная цена.
postscreen_pre_queue_limit = 20

# Свободного места на разделе, ниже которого приём почты прекращается.
#
# ЧТО К ПРОБЛЕМЕ ВЕЛО: параметр не был задан, а умолчание — 1.5 ×
# message_size_limit, то есть 15 МБ. Том postfix_mx_spool лежит в
# /var/lib/docker, на одном разделе с данными Postgres и объектами MinIO.
# «Защита» на 15 МБ означает, что postfix продолжает принимать почту ровно
# до момента, когда Postgres уже не может писать WAL. 1 ГБ — запас, при
# котором соседи по разделу ещё живы, а нам уже пора смотреть postqueue.
queue_minfree = 1073741824

# Не больше двух одновременных соединений к одному получателю (читай: к
# gmail-smtp-in).
#
# ЧТО К ПРОБЛЕМЕ ВЕЛО: параметр не был задан, умолчание —
# default_destination_concurrency_limit = 20. При накоплении очереди мы
# открывали до 20 параллельных сессий к Google с одного IP, а Google на это
# отвечает «421-4.7.28 unusual rate» и придерживает почту. Дальше петля:
# придержал → очередь растёт → qmgr давит сильнее → придерживает дольше →
# через maximal_queue_lifetime всё это превращается в отлупы.
smtp_destination_concurrency_limit = 2

inet_interfaces = all
# Только IPv4. AAAA у mail.pxcheats.com нет, входящих по IPv6 не будет, а
# IPv6-путь docker — как раз тот, где адрес источника теряется чаще всего.
inet_protocols = ipv4

# Уведомления postmaster'у здесь работают: postmaster@pxcheats.com есть в
# карте алиасов и уезжает на Gmail.
notify_classes = resource, software

biff = no
append_dot_mydomain = no

# --- Кому вернётся отлуп от Gmail (переписывание КОНВЕРТА) ------------------
#
# ЧТО К ПРОБЛЕМЕ ВЕЛО. Строки 63-68 обещают «НИКОГДА принять и отбить», и для
# несуществующих адресов обещание выполняется. Но для ЧЕТЫРЁХ СУЩЕСТВУЮЩИХ
# адресов схема была обратная по построению: мы отвечаем 250, кладём письмо в
# очередь и берём на себя доставку в Gmail. Всё, что Gmail отвергнет ПОСЛЕ
# этого (а он отвергнет: SPF чужого домена по нашему IP не сходится), postfix
# превращал в отлуп НА АДРЕС ИЗ КОНВЕРТА — а он у ботов подделан. Отлуп при
# этом уходит с нашего IP и проходит наш же SPF, то есть полностью
# атрибутируется на pxcheats.com. Второй путь того же — истечение
# maximal_queue_lifetime у придержанного письма.
#
# Настоящая работа SRS — не «починить SPF», а ПЕРЕПИСАТЬ КОНВЕРТ НА СВОЙ
# ДОМЕН, чтобы отлуп от Gmail вернулся НАМ, а не невиновному. Именно это
# здесь и сделано, но без отдельного демона postsrsd: у нас пересылка в один
# ящик, обратный разбор адреса (то, ради чего в SRS нужен демон и секрет)
# не нужен никому.
#
# ПОЧЕМУ ЭТО НЕ ЛОМАЕТ ПОДПИСЬ ОТПРАВИТЕЛЯ, ради которой весь файл написан:
# DKIM подписывает ЗАГОЛОВКИ И ТЕЛО, конверт в подпись не входит вовсе.
# Заголовки From/Sender/Reply-To не трогаются — за это отвечает
# sender_canonical_classes ниже. «Ответить» у владельца по-прежнему уходит
# исходному человеку: почтовый клиент смотрит на From, а не на Return-Path.
#
# ЦЕНА, КОТОРУЮ МЫ ЗА ЭТО ПЛАТИМ, ОСОЗНАННО: пересланное письмо теперь
# проходит SPF как наше, и спам, который мы переслали себе же, Google
# засчитывает нашему домену. Это меньшее зло: репутацию портит и то, и
# другое, но из Backscatterer.org выходят месяцами, а «пересылает себе спам»
# — вопрос фильтра на стороне Gmail.
#
# ВНИМАНИЕ: classes ОБЯЗАН быть только envelope_sender. Умолчание —
# «envelope_sender, header_sender», и оно переписало бы заголовок From,
# сломав исходную подпись DKIM, то есть ровно то, что мы бережём.
sender_canonical_classes = envelope_sender
sender_canonical_maps = regexp:/etc/postfix/sender_canonical
# [entrypoint] Файл собирается при старте из conf/sender_canonical.template.
#
# Отлупы приходят на forward@ — он есть в карте virtual и уезжает владельцу.
# Если и эта доставка не удастся, получится двойной отлуп, а он отбрасывается
# молча: 2bounce нет в notify_classes (см. выше по файлу).

maillog_file = /dev/stdout
