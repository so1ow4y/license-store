# ============================================================================
#  РОЛЬ «out» — внутренний отправитель платформы.
#
#  Кто с ним говорит: только API (nodemailer) по имени `postfix`, порт 25,
#  без авторизации, из сети compose. Портов наружу у контейнера НЕТ ВОВСЕ —
#  ни один пакет из интернета сюда не доходит, и это главная причина, по
#  которой здесь позволительно `permit_mynetworks`.
#
#  Куда он говорит: напрямую в MX получателя (Gmail и прочие). relayhost
#  пуст — мы сами себе провайдер, ровно как сегодня.
#
#  ЭТО ПУТЬ, КОТОРЫЙ УЖЕ ПРОВЕРЕН ЖИВОЙ ДОСТАВКОЙ. Любая правка в этом файле
#  требует повторной проверки по scripts/mail-check.sh и живого письма в
#  Gmail с просмотром «Показать оригинал».
#
#  Значения, помеченные [entrypoint], перекрываются при старте из переменных
#  окружения — см. docker/mail/entrypoint.sh. Здесь они стоят как значения
#  по умолчанию, чтобы файл читался целиком и без запуска.
# ============================================================================

# Уровень совместимости. Без него postfix при каждом старте пишет полотно
# предупреждений «using backwards-compatible default setting ...», в котором
# тонут настоящие ошибки. 3.6 — уровень postfix из Debian 12.
compatibility_level = 3.6

# --- Кто мы -----------------------------------------------------------------

# [entrypoint: MAIL_HOSTNAME] Имя в приветствии SMTP (HELO/EHLO).
# НЕ МЕНЯТЬ без отдельной живой проверки: именно это имя видел Gmail, когда
# принимал письма с первой попытки. Переезд на mail.pxcheats.com формально
# правильнее (совпадает с MX и A), но это отдельное изменение.
myhostname = pxcheats.com

# [entrypoint: MAIL_DOMAIN]
mydomain = pxcheats.com
myorigin = $mydomain

# --- Ничего не принимаем ----------------------------------------------------
#
# Пусто — и это решение, а не экономия. У отправителя нет ни одного локального
# ящика: нечего переполнять, нечего бэкапить, некуда доставить по ошибке и нет
# пути «письмо превратилось в локальную доставку».

mydestination =
alias_maps =
alias_database =

# ПУСТО БЫТЬ НЕ ДОЛЖНО — см. подробный разбор в conf/mx/main.cf.
#
# ЧТО К ПРОБЛЕМЕ ВЕЛО, коротко: `local_recipient_maps =` у postfix означает
# не «локальных получателей нет», а «не проверять, принимать всех». А в
# локальный класс адресов при inet_interfaces = all входят адреса
# интерфейсов в квадратных скобках, поэтому `RCPT TO:<foo@[127.0.0.1]>`
# принимался в очередь и превращался в отлуп на подставленный адрес.
#
# [entrypoint] Карта существует и пуста по содержимому: не находится никто.
local_recipient_maps = hash:/etc/postfix/local_recipients

# По умолчанию relay_domains = $mydestination. Пусто означает: мы никому не
# резервный MX и ничего не передаём дальше.
relay_domains =

# --- Кому разрешено сдавать нам письма --------------------------------------
#
# [entrypoint: MAIL_INTERNAL_NETWORKS]
#
# ПОЧЕМУ ЗДЕСЬ ЦЕЛЫЙ 172.16.0.0/12, А НЕ ТОЧНАЯ ПОДСЕТЬ COMPOSE.
# Точная подсеть неизвестна заранее: docker выдаёт её сети проекта из своего
# пула при первом создании. Прибить её в compose можно, но тогда при выкладке
# на УЖЕ РАБОТАЮЩИЙ сервер сеть придётся пересоздавать — с остановкой всех
# контейнеров, ради значения, которое ничего не защищает.
#
# Ничего не защищает — потому что у этого контейнера нет опубликованных
# портов. Достучаться до него может только тот, кто уже внутри docker-сети,
# то есть уже выполняет код на нашем сервере. Сузить список до /16 против
# /12 в такой ситуации не меняет ничего.
#
# Сузить всё же можно: задать MAIL_INTERNAL_NETWORKS в .env.production,
# подсмотрев подсеть командой
#   docker network inspect license-platform_default -f '{{(index .IPAM.Config 0).Subnet}}'
#
# IPv6-петли ([::1]/128) в списке НЕТ намеренно: ниже стоит
# inet_protocols = ipv4, и адрес, семейство которого выключено, в лучшем
# случае молча игнорируется, а в худшем — повод для предупреждения при каждом
# старте. Строка, которая ничего не делает, но выглядит осмысленной, — худший
# вид конфигурации: её копируют дальше.
mynetworks = 127.0.0.0/8 172.16.0.0/12

# СТРАХОВКА на случай, если mynetworks кто-то однажды сотрёт. По умолчанию
# postfix берёт стиль «subnet» и считает своей ВСЮ подсеть сетевого
# интерфейса — на хостинге это /24 соседей-арендаторов, и вы релеите для них.
# Это самый частый способ стать открытым релеем случайно.
mynetworks_style = host

# --- Релей ------------------------------------------------------------------
#
# Единственный параметр, который с postfix 2.10 решает «релеить или нет»;
# проверяется РАНЬШЕ smtpd_recipient_restrictions. Опасна не «неправильная»
# настройка, а ПУСТАЯ: `smtpd_relay_restrictions =` отключает проверку целиком
# и делает открытый релей одной строкой.
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination

# Второй рубеж поверх relay_restrictions. Дублирование намеренное: если
# кто-то ослабит одну строку, вторая ещё держит.
#
# reject_non_fqdn_recipient ДОБАВЛЕН ПЕРВЫМ, до permit_mynetworks.
#
# ЧТО К ПРОБЛЕМЕ ВЕЛО: при inet_interfaces = all адреса интерфейсов входят в
# ЛОКАЛЬНЫЙ класс адресов, поэтому `RCPT TO:<foo@[127.0.0.1]>` считался
# «нашим» получателем, а local_recipient_maps пуста — а пустая карта у
# postfix означает не «никого нет», а «не проверять». Письмо принималось в
# очередь, уходило в local(8), где нет ни ящиков, ни алиасов, и порождало
# отлуп на подставленный адрес отправителя. Здесь это доступно только тому,
# кто уже внутри сети compose, но стоит проверка ноль, а API адресов-литералов
# не отправляет никогда: у него все получатели — почта живых людей.
smtpd_recipient_restrictions =
    reject_non_fqdn_recipient,
    permit_mynetworks,
    reject_unauth_destination

# Третий рубеж, самый грубый и самый надёжный: с кем вообще разговаривать.
# Всё, что не из сети compose, отбривается на этапе соединения.
smtpd_client_restrictions = permit_mynetworks, reject

# --- От кого разрешено отправлять -------------------------------------------
#
# ЧТО К ПРОБЛЕМЕ ВЕЛО: этой директивы здесь НЕ БЫЛО ВОВСЕ (в роли mx она
# есть). Вместе с mynetworks = 172.16.0.0/12 это означало: любой процесс,
# оказавшийся в сети compose или на самом хосте — шлюз docker-сети тоже
# входит в 172.16.0.0/12, — мог сдать нам письмо ОТ ЛЮБОГО ОТПРАВИТЕЛЯ
# ЛЮБОМУ ПОЛУЧАТЕЛЮ В МИРЕ, а мы доставили бы его с нашего IP и с нашей
# репутацией. Из интернета этого не сделать (портов у контейнера нет), но
# «уже внутри» — это ровно тот случай, ради которого разделены роли.
#
# check_sender_access с inline-таблицей, а не отдельный файл: ключ ровно
# один, а файл на одну строку — это ещё один файл, который может разойтись
# с конфигурацией. Запятых внутри {} быть не должно: список ограничений
# разбирается по запятым раньше, чем таблица.
#
# [entrypoint: MAIL_DOMAIN] строка пересобирается при старте под нужный домен.
#
# Пустой адрес конверта («<>», с ним ходят отлупы) сюда не попадает: письма
# API всегда с адресом, а собственные отлупы postfix проходят мимо smtpd.
#
# ВНИМАНИЕ ПРИ ПРАВКЕ: домен здесь обязан совпадать с доменом в SMTP_FROM из
# .env.production. Не совпадёт — API получит 554 на КАЖДОЕ письмо. Это
# сверяет scripts/mail-check.sh, но лучше не доводить.
smtpd_sender_restrictions =
    reject_non_fqdn_sender,
    check_sender_access inline:{pxcheats.com=OK},
    reject

# Расширение DSN (RFC 3461) не объявляется и его параметры не принимаются.
#
# ЧТО К ПРОБЛЕМЕ ВЕЛО: умолчание пусто, то есть smtpd анонсировал DSN и
# принимал `RET=FULL` + `NOTIFY=SUCCESS`. Это способ заставить postfix самого
# сочинить письмо с чужим текстом внутри и отправить его на адрес, названный
# отправителем, — с нашего IP и в обход всех проверок релея, потому что
# получатель у исходного письма легальный. nodemailer DSN не использует,
# так что отключение не стоит нам ничего.
smtpd_discard_ehlo_keywords = silent-discard, dsn

# --- Закрытие обходных путей адресации --------------------------------------
#
# Классические трюки обхода reject_unauth_destination. Значения по умолчанию
# у всех трёх верные — пишем явно, чтобы правка «на глазок» была заметна.

# Запрещает `user@remote@pxcheats.com` и маршрутизацию от источника
# `@remote:user@pxcheats.com`: адрес выглядит нашим, а доставка уходит наружу.
allow_untrusted_routing = no
# Убивает `user%gmail.com@pxcheats.com` — исторический синтаксис, который
# postfix иначе перепишет в `user@gmail.com` ПОСЛЕ проверок.
allow_percent_hack = no
# То же для UUCP-нотации `gmail.com!user@pxcheats.com`.
swap_bangpath = no

# XCLIENT позволяет клиенту объявить себя другим IP-адресом. Пустой список —
# никому не позволено; заполнение этих полей обнуляет все защиты выше.
smtpd_authorized_xclient_hosts =
smtpd_authorized_xforward_hosts =

# --- Авторизация ------------------------------------------------------------
#
# Её нет. API ходит из своей сети без пароля, и подбирать здесь нечего.
smtpd_sasl_auth_enable = no

# --- TLS --------------------------------------------------------------------
#
# ВХОДЯЩИЙ (от API). [entrypoint] Если в контейнер смонтированы сертификаты
# (тот же каталог, что у nginx), entrypoint поднимет уровень до `may` и
# пропишет пути. Если сертификатов нет — остаётся `none`, и nodemailer
# отдаёт письмо открытым текстом ВНУТРИ docker-сети, не покидая хост.
# Это безопасно и совпадает с тем, что API и так отключает проверку
# сертификата для внутреннего релея (mail.service.ts, признак internalRelay).
smtpd_tls_security_level = none

# ИСХОДЯЩИЙ (к Gmail и прочим). `may` — оппортунистический TLS: шифруем,
# если сервер получателя предлагает, и не отказываемся от доставки, если нет.
# `encrypt` здесь был бы вреден: часть мелких MX не умеет STARTTLS, и письма
# к ним просто не ушли бы.
smtp_tls_security_level = may
smtp_tls_note_starttls_offer = yes
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1

# --- Подпись DKIM -----------------------------------------------------------
#
# Подписывает ОТДЕЛЬНЫЙ контейнер opendkim — единственное место, где лежит
# закрытый ключ. Публичный postfix-mx этого ключа не видит вовсе.
#
# ПОЧЕМУ tempfail, А НЕ accept. `accept` означает: если opendkim не отвечает,
# письмо уходит НЕПОДПИСАННЫМ. Внешне всё хорошо, в журнале ни одной ошибки,
# а письма тихо ложатся в спам — самая дорогая из возможных поломок.
# `tempfail` вместо этого отвечает API кодом 4xx: письмо остаётся в очереди
# notifications со статусом PENDING, повторится позже и уйдёт подписанным.
# Поломка становится ГРОМКОЙ: её видно и в postqueue, и в журнале API.
#
# ЧЕМ ЭТО БЫЛО ОПАСНО ДО ПРАВКИ ОБРАБОТЧИКА (и почему нельзя вернуть tempfail
# «просто так», если обработчик когда-нибудь упростят обратно). Обработчик
# уведомлений делал пять попыток подряд с шагом 5 секунд и после пятой ставил
# статус FAILED — окончательный, из него уведомление не возвращается ничем,
# кроме ручной пересылки. То есть 4xx в течение 25 секунд означал не
# «письмо подождёт», а «письма не будет никогда». А 25 секунд недоступного
# милтера даёт ЛЮБАЯ выкладка: deploy.sh пересобирает и пересоздаёт
# lp-opendkim, плюс start-period healthcheck.
#
# Теперь между попытками стоит нарастающая пауза (1 мин → 4 часа, восемь
# попыток, около восьми часов суммарно), а временные отказы 4xx и обрывы
# соединения отделены от постоянных 5xx —
# apps/api/src/modules/notifications/notification.processor.ts.
# Вторая опора — том postfix_out_spool: то, что postfix уже принял, переживает
# пересоздание контейнера.
milter_default_action = tempfail
smtpd_milters = inet:opendkim:8891
non_smtpd_milters = $smtpd_milters

# --- Очередь и пределы ------------------------------------------------------

# 3 суток на доставку, сутки на доставку отлупа. Стандартные значения (5 суток)
# на нашем объёме означают лишь, что мёртвое письмо лежит дольше.
maximal_queue_lifetime = 3d
bounce_queue_lifetime = 1d

message_size_limit = 10485760
mailbox_size_limit = 0

# Одно ядро и 64 МБ лимита: сотня процессов по умолчанию — это способ
# получить OOM при первой же пачке рассылки. Десяти хватает с запасом:
# nodemailer держит пул из трёх соединений (mail.service.ts, maxConnections).
default_process_limit = 10

# Только IPv4. У контейнеров docker в этом проекте IPv6 не настроен, а
# inet_protocols = all заставляет postfix пытаться разрешать AAAA и писать
# в журнал «Network is unreachable» на каждое второе письмо.
inet_interfaces = all
inet_protocols = ipv4

# Уведомления postmaster'у выключены намеренно. Отправителю их слать некуда:
# до шага B приём почты ещё не работает, и каждое такое уведомление просто
# оседало бы в очереди, засоряя проверку «postqueue -p пуст».
notify_classes =

# --- Гигиена ----------------------------------------------------------------

smtpd_helo_required = yes
# VRFY — штатный инструмент перебора адресов. Нам он не нужен ни для чего.
disable_vrfy_command = yes
biff = no
# Postfix не должен дописывать домен к адресам без @ — все адреса у нас
# полные, а «дополнение» неполного адреса маскирует ошибки в коде.
append_dot_mydomain = no

# --- Журнал -----------------------------------------------------------------
#
# В stdout, а не в syslog: в контейнере нет rsyslog, и лишний демон — это ещё
# один процесс, который может умереть молча. `docker logs lp-postfix` должен
# показывать всё.
maillog_file = /dev/stdout
