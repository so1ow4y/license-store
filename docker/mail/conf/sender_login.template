# ============================================================================
#  Кто под какой учётной записью имеет право писать от какого адреса.
#  Используется ТОЛЬКО службой submission (порт 587), директивой
#  reject_sender_login_mismatch.
#
#  Слева — адрес в поле MAIL FROM, справа — логин SASL, которому он разрешён.
#  Логин полный, с областью: смотри smtpd_sasl_local_domain в mx/main.cf.
#
#  ЗАЧЕМ. Без этой карты вошедший под учёткой support мог бы отправлять от
#  noreply@ — то есть от имени платформы, с нашей подписью DKIM. И, что
#  важнее, то же самое смог бы любой, кто украдёт пароль. Карта превращает
#  кражу пароля из «отправка чего угодно от кого угодно» в «отправка от
#  одного известного адреса», что видно в первый же день.
#
#  Адреса, которых здесь нет, отправить через 587 нельзя вообще — включая
#  noreply@: платформа отправляет не отсюда, а через роль «out», у которой
#  порт 587 не открыт и авторизации нет.
# ============================================================================

support@%MAIL_DOMAIN%       support@%MAIL_DOMAIN%
