# shellcheck shell=sh
# Определяет, есть ли сертификат, и объявляет это ПЕРЕМЕННОЙ ОКРУЖЕНИЯ.
#
# ЗАЧЕМ ОТДЕЛЬНО ОТ 25-tls-optional. Тот скрипт правит уже готовые файлы
# конфигурации и потому обязан идти ПОСЛЕ подстановки шаблонов (20-envsubst).
# А переменная нужна ВНУТРИ шаблона — значит объявить её надо ДО подстановки.
# Отсюда номер 14: раньше двадцатого.
#
# Что от неё зависит: принудительный переход с HTTP на HTTPS. Включать его
# безусловно нельзя — в режиме без сертификата это запирает доступ намертво:
# HTTP уже перенаправляет, HTTPS ещё не отвечает, и починить нечем, кроме
# правки конфигурации на сервере. Поэтому решение принимается по факту
# наличия файла, а не по намерению.
#
# Расширение .envsh обязательно: entrypoint такие файлы SOURCE'ит, и только
# так export доезжает до 20-envsubst-on-templates.sh.

if [ -r /etc/nginx/certs/fullchain.pem ] && [ -r /etc/nginx/certs/privkey.pem ]; then
    LP_HTTPS=1
    entrypoint_log "$0: сертификат на месте — HTTP будет перенаправлять на HTTPS"
else
    # Пустая строка, а не «0»: в nginx условие ложно для пустой строки и для
    # «0», но пустая честнее выражает «признака нет».
    LP_HTTPS=""
    entrypoint_log "$0: сертификата нет — HTTP остаётся рабочим, без перенаправления"
fi

export LP_HTTPS
