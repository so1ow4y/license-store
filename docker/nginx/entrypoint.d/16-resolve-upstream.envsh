# shellcheck shell=sh
# Превращает имя апстрима в конкретный IPv4 ДО подстановки шаблонов.
#
# ЗАЧЕМ. Docker Desktop пишет для host.docker.internal (и для любого имени,
# заданного через host-gateway) ДВЕ записи в /etc/hosts:
#     192.168.65.254        lp-host
#     fdc4:f303:9324::254   lp-host
# Глобального IPv6 на eth0 у контейнера нет, но nginx резолвит имя ОДИН раз
# при старте и заводит peer'а на КАЖДЫЙ полученный адрес. Мёртвый IPv6
# попадает в пул наравне с живым IPv4, и половина коннектов спасается только
# прозрачным ретраем: в error.log это «connect() failed (101: Network
# unreachable)» на каждом втором запросе. Настоящая ошибка апстрима в таком
# логе не видна, а при max_fails на живом peer'е одна транзиентная ошибка
# способна выбить его из пула и оставить только мёртвый — то есть 502 всем.
#
# ПОЧЕМУ НЕ СРЕДСТВАМИ NGINX. У директивы server нет параметра «только IPv4».
# resolver ... ipv6=off действует лишь на рантайм-резолв через переменную в
# proxy_pass, за который платится потеря keepalive к бэкенду и превращение
# ошибки конфигурации в 502. Здесь же вопрос решается один раз при старте.
#
# ПОЧЕМУ НЕ ЗАХАРДКОДИТЬ 192.168.65.254. Этот адрес — деталь реализации
# Docker Desktop, он менялся между версиями и отличается на других платформах.
# Имя остаётся источником истины, фиксируется только семейство адресов.
#
# Расширение .envsh, а не .sh, обязательно: entrypoint такие файлы SOURCE'ит,
# и только так экспорт доезжает до 20-envsubst-on-templates.sh. Файл с .sh
# выполнился бы в подоболочке и переменную бы потерял.

entrypoint_log "$0: разрешение апстрима $API_UPSTREAM"

_upstream_host="${API_UPSTREAM%:*}"
_upstream_port="${API_UPSTREAM##*:}"

case "$API_UPSTREAM" in
    # Уже литеральный IPv4[:порт] — резолвить нечего.
    [0-9]*.[0-9]*.[0-9]*.[0-9]*:*) _upstream_host="" ;;
    # Без порта форма нам неизвестна, не трогаем.
    *:*) ;;
    *) _upstream_host="" ;;
esac

if [ -n "$_upstream_host" ]; then
    # ahostsv4, а не hosts: именно он отсекает AAAA. Берём первый адрес —
    # у host-gateway он всегда один.
    _upstream_ip="$(getent ahostsv4 "$_upstream_host" 2>/dev/null | awk 'NR==1 {print $1}')"

    if [ -n "$_upstream_ip" ]; then
        API_UPSTREAM="${_upstream_ip}:${_upstream_port}"
        export API_UPSTREAM
        entrypoint_log "$0: $_upstream_host -> $API_UPSTREAM (только IPv4)"
    else
        # Не падаем: имя может резолвиться средствами самого nginx (профиль
        # full, где апстрим — соседний контейнер в сети compose и IPv6 там
        # не появляется). Отказ здесь означал бы, что диагностический скрипт
        # ломает рабочую конфигурацию.
        entrypoint_log "$0: $_upstream_host не разрешился в IPv4, оставляю имя как есть"
    fi
fi

unset _upstream_host _upstream_port _upstream_ip
