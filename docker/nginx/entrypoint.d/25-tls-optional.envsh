# shellcheck shell=sh
# HTTPS включается сам, если сертификаты на месте, и молча выключается, если нет.
#
# ЗАЧЕМ. nginx падает на старте, когда ssl_certificate указывает на
# несуществующий файл. Держи мы 443 в основном конфиге — контейнер не
# поднялся бы ни у кого, кто просто склонировал репозиторий и запустил
# compose: разработка требовала бы сначала завести сертификат. Поэтому
# TLS живёт в отдельных файлах, и здесь они либо остаются, либо удаляются.
#
# ПОЧЕМУ ПО СОДЕРЖИМОМУ, А НЕ ПО ИМЕНИ. Первая версия удаляла ровно один
# файл — tls.conf. Потом появился s3.conf со своим ssl_certificate для
# поддомена хранилища, а про него здесь никто не знал: скрипт бодро писал
# «HTTPS ВЫКЛЮЧЕН», после чего nginx падал на сертификате, которого нет.
# Список имён — это знание, обязанное обновляться в двух местах, и однажды
# оно не обновится. Признак же однозначен: конфигу нужен сертификат тогда
# и только тогда, когда в нём есть директива ssl_certificate. Поэтому файлы
# ищутся по ней, и следующий такой конфиг подхватится сам.
#
# Расширение .envsh, а не .sh: entrypoint такие файлы SOURCE'ит, и
# entrypoint_log доступен. Порядок важен — 20-envsubst-on-templates.sh
# уже отработал и разложил конфиги в conf.d, мы правим результат.
#
# Права на исполнение обязательны: неисполняемый файл entrypoint пропускает
# со строкой «Ignoring ..., not executable» — без ошибки и без падения.
# На Windows бита +x нет, его ставит scripts/deploy.sh после копирования.

_cert=/etc/nginx/certs/fullchain.pem
_key=/etc/nginx/certs/privkey.pem

# Конфиги, которым нужен сертификат. Директива может стоять с любым отступом,
# поэтому якоря на начало строки нет; закомментированные строки отсекаются,
# иначе объяснение в шапке чужого файла сошло бы за настройку.
_tls_confs=""
for _f in /etc/nginx/conf.d/*.conf; do
    [ -f "$_f" ] || continue
    if grep -qE '^[[:space:]]*ssl_certificate[[:space:]]' "$_f"; then
        _tls_confs="$_tls_confs $_f"
    fi
done

if [ -z "$_tls_confs" ]; then
    entrypoint_log "$0: конфигов с TLS нет — проверять нечего"
elif [ -r "$_cert" ] && [ -r "$_key" ]; then
    entrypoint_log "$0: сертификат найден, HTTPS включён на 443:$_tls_confs"
else
    for _f in $_tls_confs; do
        rm -f "$_f"
        entrypoint_log "$0: убран $_f — ему нужен сертификат"
    done
    entrypoint_log "$0: сертификата нет ($_cert), HTTPS ВЫКЛЮЧЕН — работает только HTTP"
    entrypoint_log "$0: локально: powershell -File scripts/make-dev-cert.ps1"
    entrypoint_log "$0: в проде: certbot certonly --webroot -w /var/www/certbot -d ВАШ.ДОМЕН"
fi

unset _cert _key _f _tls_confs
