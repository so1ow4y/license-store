# ============================================================================
#  Конфигурация nginx для License Platform.
#
#  Это шаблон: entrypoint образа nginx прогоняет файлы из
#  /etc/nginx/templates/*.template через envsubst и кладёт результат
#  в /etc/nginx/conf.d/. Благодаря этому адрес бэкенда задаётся переменной,
#  и один и тот же конфиг работает в двух режимах:
#
#    API_UPSTREAM=api:3000              — всё в Docker
#    API_UPSTREAM=192.168.65.254:3000   — API запущен нативно с горячей
#                                         перезагрузкой (адрес хоста, а НЕ
#                                         host.docker.internal — см. блок
#                                         upstream ниже, там же причина)
#
#  Директивы ниже относятся к контексту http и подхватываются штатным
#  nginx.conf через include /etc/nginx/conf.d/*.conf.
# ============================================================================

# Логи в JSON — тот же формат, что у приложения, чтобы сборщик логов
# обрабатывал оба источника одинаково. request_id пробрасывается насквозь:
# по нему связываются запись nginx, лог приложения и строка в audit_logs.
log_format json_combined escape=json
  '{'
    '"time":"$time_iso8601",'
    '"request_id":"$request_id",'
    '"remote_addr":"$remote_addr",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"status":$status,'
    '"bytes":$body_bytes_sent,'
    '"duration":$request_time,'
    '"upstream_time":"$upstream_response_time",'
    '"user_agent":"$http_user_agent"'
  '}';

# ------------------------------------------------------------------
#  Зоны ограничения скорости.
#
#  Первый рубеж обороны, до приложения. Смысл в том, чтобы перебор паролей
#  не доходил до Argon2: каждый такой запрос стоит около 70 мс процессорного
#  времени, и без ограничения на входе один скрипт займёт все ядра.
#
#  ОБЩЕГО прикладного rate limit в API сегодня НЕТ: @nestjs/throttler не
#  подключён, троттлинга в коде нет. Единственный прикладной порог живёт на
#  выдаче payload'а и считает выдачи на ЛИЦЕНЗИЮ, а не на адрес. То есть
#  эти зоны — не «второй рубеж с запасом», а единственная защита от перебора
#  по IP; снимать их нельзя, а ослаблять — только осознанно.
# ------------------------------------------------------------------
# Признак «перенаправлять ли HTTP на HTTPS».
#
# Значение по умолчанию приходит из окружения (14-tls-detect.envsh): «1»,
# когда сертификат на месте, и пустая строка, когда его нет.
#
# Путь проверки владения доменом исключён ЯВНО и это не перестраховка:
# certbot ходит за файлом по HTTP, а перенаправление на HTTPS во время
# продления сертификата означало бы, что продлить его больше нельзя.
# Поймать такое можно только через три месяца, когда текущий истечёт.
map $request_uri $lp_force_https {
    default                            "${LP_HTTPS}";
    "~^/\.well-known/acme-challenge/"  "";
}

# ------------------------------------------------------------------
#  Списки центра безопасности (apps/api/.../security-center/edge.service.ts).
#
#  Файлы пишет агент синхронизации (entrypoint.d/30-lp-edge-sync.sh): он
#  забирает их у API по EDGE_AGENT_TOKEN и перезагружает nginx, только
#  когда содержимое изменилось. Пока API не ответил или токена нет, файлы
#  пустые и nginx работает как раньше. Ключ — адрес сокета ($remote_addr),
#  тот же, что у limit_req: почему не X-Forwarded-For, см. lp-locations.conf.
#
#  $lp_edge_blocked — блоки уровней «nginx» и «фаервол»: 403 до прокси в API.
#  $lp_trusted      — доверенные адреса из «приоритета трафика»: мимо
#                     limit_req и limit_conn. Во время флуда администратор
#                     не должен упираться в лимиты, рассчитанные на чужие
#                     скрипты, — иначе DDoS отрезает именно его.
# ------------------------------------------------------------------
geo $lp_edge_blocked {
    default 0;
    include /etc/nginx/lp-edge/blocklist.conf;
}

geo $lp_trusted {
    default 0;
    include /etc/nginx/lp-edge/priority.conf;
}

# Пустой ключ limit_req/limit_conn не учитывается вовсе: так доверенные
# выходят из-под лимитов без отдельных location и копий директив.
map $lp_trusted $lp_limit_key {
    default $binary_remote_addr;
    1       "";
}

limit_req_zone $lp_limit_key zone=auth_zone:10m     rate=10r/m;
limit_req_zone $lp_limit_key zone=api_zone:10m      rate=300r/m;
limit_req_zone $lp_limit_key zone=launcher_zone:10m rate=120r/m;

# Отдельная зона под payload. Своя, а не общая с launcher_zone, потому что
# ответ здесь на три порядка тяжелее проверки лицензии и делить с ней один
# бюджет нельзя: поток проверок съедал бы право на запуск.
# Ставка та же, что у launcher_zone, — см. рассуждение в самом location.
limit_req_zone $lp_limit_key zone=payload_zone:10m  rate=120r/m;

limit_req_status 429;

limit_conn_zone $lp_limit_key zone=conn_zone:10m;

# ------------------------------------------------------------------
#  Апстрим.
#
#  API_UPSTREAM обязан резолвиться ТОЛЬКО в IPv4 — это не пожелание, а
#  требование, за нарушение которого платит каждый запуск. Факт со стенда
#  (docker logs lp-nginx, 103 пары строк за 76 минут аптайма):
#
#    connect() to [fdc4:f303:9324::254]:3000 failed (101: Network unreachable)
#    upstream server temporarily disabled while connecting to upstream
#
#  host.docker.internal в контейнере резолвится И в 192.168.65.254, И в
#  fdc4:f303:9324::254 — Docker Desktop пишет в /etc/hosts обе строки, а
#  глобального IPv6 на eth0 у контейнера нет. nginx резолвит имя ОДИН РАЗ при
#  старте и заводит peer'а на КАЖДЫЙ полученный адрес, поэтому мёртвый IPv6
#  попадает в пул наравне с живым IPv4, и каждый второй коннект спасается
#  только прозрачным ретраем на connect-фазе (виден в access-логе двойным
#  значением upstream_time: "0.000, 0.072").
#
#  Отфильтровать семейство адресов средствами nginx нечем: у server нет
#  параметра «только IPv4», а resolver ... ipv6=off действует лишь на
#  рантайм-резолв через переменную в proxy_pass, за который платится потеря
#  keepalive к бэкенду и 502 вместо ошибки конфигурации при недоступном DNS.
#  Поэтому адрес задаётся снаружи и именно литералом:
#
#    API_UPSTREAM=192.168.65.254:3000   — API нативно на хосте (Docker Desktop,
#                                         тот же адрес, что host.docker.internal;
#                                         на Linux-хосте это 172.17.0.1)
#    API_UPSTREAM=api:3000              — профиль full; у сервиса в сети docker
#                                         записи AAAA нет вовсе, имя безопасно
# ------------------------------------------------------------------
upstream api_upstream {
    # max_fails=3 — про ЖИВОЙ peer, а не про мёртвый. При умолчании
    # max_fails=1 ОДНА транзиентная ошибка коннекта (перезапуск API в
    # разработке — обычное дело) снимает единственный рабочий адрес на
    # fail_timeout, и если рядом в пуле оказался нерабочий, все запуски
    # в эти секунды получают «no live upstreams» → 502. Три ошибки за
    # 10 секунд — уже не случайность, а состояние бэкенда.
    #
    # proxy_next_upstream оставлен умолчанием (error timeout): он повторяет
    # только на connect-фазе и НЕ переотправляет неидемпотентный запрос,
    # уже ушедший бэкенду. Добавлять сюда non_idempotent нельзя — это
    # означало бы вторую выдачу payload'а по одному sessionKey.
    server ${API_UPSTREAM} max_fails=3 fail_timeout=10s;
    keepalive 32;
}

# ------------------------------------------------------------------
#  Тело ошибок, которые порождает САМ nginx.
#
#  Такие ответы до приложения не доходят (в логе API их нет вовсе), поэтому
#  форму ApiErrorBody им придаёт конфиг. Коды взяты из словаря приложения
#  (all-exceptions.filter.ts, codeFromStatus): 4xx без отдельного кода — ERROR,
#  5xx — INTERNAL_ERROR. Исключение сделано для 502/504: их приложение не
#  порождает никогда, означают они «бэкенд недоступен», а загрузчик по §2.3
#  ветвится по code и повторяет только SERVICE_UNAVAILABLE. Отдать здесь
#  INTERNAL_ERROR значило бы превратить перезапуск API в терминальный экран
#  у невиновного пользователя.
# ------------------------------------------------------------------
map $status $lp_error_code {
    default "ERROR";
    400     "BAD_REQUEST";
    500     "INTERNAL_ERROR";
    501     "INTERNAL_ERROR";
    502     "SERVICE_UNAVAILABLE";
    504     "SERVICE_UNAVAILABLE";
}

map $status $lp_error_message {
    default "Запрос не может быть обработан";
    400     "Некорректный запрос";
    405     "Метод не поддерживается";
    408     "Истекло время ожидания запроса";
    413     "Тело запроса слишком велико";
    414     "Слишком длинный адрес запроса";
    431     "Слишком большие заголовки запроса";
    500     "Внутренняя ошибка сервера";
    501     "Внутренняя ошибка сервера";
    502     "Сервис временно недоступен, повторите попытку";
    504     "Сервис временно недоступен, повторите попытку";
}

# Retry-After только там, где повтор осмыслен. Пустое значение add_header
# не добавляет вовсе, поэтому на 4xx заголовка не будет — а он там и вреден:
# по §2.3 4xx кроме 429 повторять запрещено.
map $status $lp_retry_after {
    default "";
    502     "5";
    504     "5";
}

server {
    listen 80;
    # IPv6 обязателен: внутри контейнера localhost резолвится в ::1, и без
    # этой строки healthcheck получает «connection refused», хотя снаружи
    # всё работает. Штатный скрипт образа 10-listen-on-ipv6-by-default.sh
    # правит только стоковый default.conf и отрабатывает ДО подстановки
    # шаблонов, поэтому нашего конфига не касается.
    listen [::]:80;
    server_name _;

    access_log /var/log/nginx/access.log json_combined;

    client_max_body_size 2m;
    limit_conn conn_zone 50;

    # Скрываем версию nginx: бесплатная подсказка для сканеров уязвимостей.
    server_tokens off;

    gzip on;
    gzip_types application/json application/javascript text/css text/plain;
    gzip_min_length 1024;


    # --- ACME: проверка владения доменом --------------------------
    #
    # Стоит ДО include с остальными маршрутами: certbot кладёт сюда файл и
    # ждёт его по HTTP. Порт 80 поэтому и остаётся открытым даже когда
    # включён HTTPS — без него сертификат нечем продлить.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    # --- Принудительный переход на HTTPS --------------------------
    #
    # Включается САМ, когда появляется сертификат: признак приходит из
    # 14-tls-detect.envsh через $lp_force_https. Без сертификата условие
    # ложно, и HTTP продолжает обслуживать как обычно — иначе режим без
    # сертификата запирал бы доступ намертво.
    #
    # ПОЧЕМУ `if`, а не `location / { return 301 ... }`, как было задумано
    # изначально: `location /` теперь объявлен в общем файле маршрутов
    # (там раздаётся собранный фронтенд), и второй такой же nginx не примет —
    # «duplicate location». А server-level `if` с одним только `return` —
    # ровно тот случай, который в nginx считается безопасным.
    #
    # ACME при этом не ломается: путь проверки исключён на уровне map выше,
    # там условие пустое. Обычный `location ^~` тут бы не спас — server-level
    # `if` отрабатывает РАНЬШЕ выбора location, то есть перенаправил бы и
    # запрос certbot, и продление сертификата перестало бы работать молча.
    if ($lp_force_https) {
        return 301 https://$host$request_uri;
    }

    include /etc/nginx/snippets/lp-locations.conf;
}
