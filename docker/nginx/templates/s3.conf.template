# ============================================================================
#  Хранилище на отдельном поддомене: s3.<домен> → контейнер s3.
#
#  Поддомен, а не путь вроде /s3/: S3 подписывает presigned-ссылки вместе с
#  хостом и путём, и переписывание префикса ломает подпись
#  (SignatureDoesNotMatch). Наружу адрес нужен, потому что ссылки на загрузку
#  уходят в браузер администратора.
#
#  Файл удаляется скриптом 25-tls-optional.envsh, если сертификата нет.
# ============================================================================

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    # Точное имя выигрывает у server_name _ в tls.conf, иначе запросы к
    # хранилищу уходили бы в API.
    server_name s3.${LP_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    access_log /var/log/nginx/access.log json_combined;
    server_tokens off;

    # Дистрибутивы крупнее payload (8 МиБ) — берём с запасом, но не без предела.
    client_max_body_size 512m;

    # Без буферизации: иначе большая загрузка сначала целиком ложится во
    # временный файл nginx и только потом уходит в хранилище.
    proxy_request_buffering off;
    proxy_buffering off;

    proxy_connect_timeout 5s;
    proxy_send_timeout    300s;
    proxy_read_timeout    300s;

    location / {
        proxy_pass http://s3:9000;
        proxy_http_version 1.1;

        # Host передаётся как есть: подпись проверяется вместе с ним.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }
}
