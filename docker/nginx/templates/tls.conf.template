# ============================================================================
#  HTTPS. Отдельный файл, а не блок в default.conf.template, намеренно.
#
#  nginx падает на старте, если ssl_certificate указывает на несуществующий
#  файл. Держи мы 443 в основном конфиге — контейнер не поднялся бы ни у кого,
#  кто просто склонировал репозиторий и запустил compose. Поэтому TLS живёт
#  отдельно, а скрипт 25-tls-optional.sh удаляет этот файл, если сертификатов
#  нет, и пишет в лог, почему.
#
#  Сертификаты монтируются в /etc/nginx/certs:
#    fullchain.pem — цепочка (сертификат + промежуточные)
#    privkey.pem   — закрытый ключ
#
#  Локально:  powershell -File scripts/make-dev-cert.ps1
#  В проде:   certbot certonly --webroot -w /var/www/certbot -d ваш.домен
#             и монтировать /etc/letsencrypt/live/<домен>/ в /etc/nginx/certs
# ============================================================================

server {
    # default_server ОБЯЗАТЕЛЕН, и вот почему.
    #
    # `server_name _` — это НЕ шаблон «любое имя», как принято думать. Это
    # просто невалидное имя, которое не совпадает ни с чем; блок работал лишь
    # потому, что был на своём порту единственным. Когда рядом появился
    # s3.conf с точным именем, для Host: pxcheats.com не совпал НИ ОДИН блок,
    # и nginx отдал запрос серверу по умолчанию — то есть первому объявленному
    # на этом порту. Файлы conf.d подключаются по алфавиту, «s3» идёт раньше
    # «tls», и весь сайт по HTTPS начал отвечать XML-ошибкой MinIO.
    #
    # На порту 80 то же самое не проявлялось: там s3.conf не слушает вовсе.
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Только TLS 1.2 и 1.3. Всё, что ниже, ломается о современные клиенты
    # и о требования платёжных площадок, а нужно ровно никому: WinHTTP на
    # поддерживаемых версиях Windows умеет 1.2 с 2015 года.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # OCSP stapling выключен намеренно: для самоподписанного сертификата
    # он бессмысленен, а для боевого требует ssl_trusted_certificate,
    # которого у самоподписанного нет. Включается вместе с certbot.

    # HSTS. Полгода и без includeSubDomains: браузер запомнит запрет на
    # HTTP по этому домену, и откатиться назад будет нельзя до истечения
    # срока. Начинать с малого — единственный безопасный путь.
    add_header Strict-Transport-Security "max-age=15768000" always;

    access_log /var/log/nginx/access.log json_combined;

    client_max_body_size 2m;
    limit_conn conn_zone 50;
    server_tokens off;

    gzip on;
    gzip_types application/json application/javascript text/css text/plain;
    gzip_min_length 1024;

    include /etc/nginx/snippets/lp-locations.conf;
}
